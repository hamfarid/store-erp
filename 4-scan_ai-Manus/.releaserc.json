{
  "branches": [
    "main",
    {
      "name": "develop",
      "prerelease": "dev"
    },
    {
      "name": "release/*",
      "prerelease": "rc"
    }
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "type": "feat", "release": "minor" },
          { "type": "feature", "release": "minor" },
          { "type": "fix", "release": "patch" },
          { "type": "bugfix", "release": "patch" },
          { "type": "perf", "release": "patch" },
          { "type": "revert", "release": "patch" },
          { "type": "docs", "release": false },
          { "type": "style", "release": false },
          { "type": "chore", "release": false },
          { "type": "refactor", "release": false },
          { "type": "test", "release": false },
          { "type": "build", "release": false },
          { "type": "ci", "release": false },
          { "breaking": true, "release": "major" }
        ],
        "parserOpts": {
          "noteKeywords": ["BREAKING CHANGE", "BREAKING CHANGES", "BREAKING"]
        }
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "✨ ميزات جديدة | Features", "hidden": false },
            { "type": "feature", "section": "✨ ميزات جديدة | Features", "hidden": false },
            { "type": "fix", "section": "🐛 إصلاحات | Bug Fixes", "hidden": false },
            { "type": "bugfix", "section": "🐛 إصلاحات | Bug Fixes", "hidden": false },
            { "type": "perf", "section": "⚡ تحسينات الأداء | Performance", "hidden": false },
            { "type": "revert", "section": "⏪ التراجعات | Reverts", "hidden": false },
            { "type": "docs", "section": "📝 التوثيق | Documentation", "hidden": false },
            { "type": "style", "section": "💄 التنسيق | Styles", "hidden": true },
            { "type": "chore", "section": "🔧 صيانة | Chores", "hidden": true },
            { "type": "refactor", "section": "♻️ إعادة الهيكلة | Refactoring", "hidden": false },
            { "type": "test", "section": "✅ الاختبارات | Tests", "hidden": true },
            { "type": "build", "section": "📦 البناء | Build", "hidden": true },
            { "type": "ci", "section": "👷 CI/CD", "hidden": true }
          ]
        },
        "writerOpts": {
          "commitsSort": ["subject", "scope"]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# سجل التغييرات | Changelog\n\nجميع التغييرات الملحوظة في هذا المشروع موثقة في هذا الملف.\n\nAll notable changes to this project are documented in this file.\n"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "echo 'Preparing release ${nextRelease.version}'",
        "publishCmd": "echo 'Publishing release ${nextRelease.version}'",
        "successCmd": "echo 'Successfully released ${nextRelease.version}'"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json",
          "package-lock.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/**/*.zip",
            "label": "Distribution (${nextRelease.version})"
          }
        ],
        "successComment": "🎉 هذا الإصدار متاح الآن في [${nextRelease.version}](${releases[0].url})\n\nThis release is now available at [${nextRelease.version}](${releases[0].url})",
        "failComment": "❌ فشل الإصدار. يرجى التحقق من السجلات.\n\nRelease failed. Please check the logs.",
        "releasedLabels": ["released", "shipped"],
        "addReleases": "bottom"
      }
    ]
  ]
}
